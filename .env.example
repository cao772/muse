# Copy to .env if you need overrides. Stage 0 works without this file or API keys.
MUSE_HOST=127.0.0.1
MUSE_PORT=8000
# mock is offline; deepseek/qwen/openai-compatible require explicit credentials.
MUSE_PROVIDER=mock
MUSE_MAX_MESSAGE_BYTES=16384
# LAN mode requires a generated token and the Mac's explicit LAN IP in allowed hosts.
MUSE_DEVICE_ID=muse-01
MUSE_DEVICE_TOKEN=
MUSE_ALLOWED_HOSTS=["localhost","127.0.0.1","::1","testserver"]
MUSE_ALLOWED_ORIGINS=[]
MUSE_MAX_CONNECTIONS=2
MUSE_IDLE_TIMEOUT_SECONDS=30
MUSE_PROVIDER_TIMEOUT_SECONDS=15

# Real LLM: DeepSeek official OpenAI-compatible endpoint. Never commit real keys.
MUSE_LLM_API_KEY=
MUSE_LLM_BASE_URL=https://api.deepseek.com
MUSE_LLM_MODEL=deepseek-flash
MUSE_LLM_MAX_TOKENS=256
# Local STT is optional, Apple Silicon: uv sync --extra stt
MUSE_STT_PROVIDER=mock
MUSE_STT_MODEL=mlx-community/whisper-large-v3-turbo

# Optional read-only Personal Agent bridge to the local CAO Project OS.
# P1 only queries loopback HTTP; it cannot start Codex, mutate projects, push, or merge.
MUSE_CAO_ENABLED=false
MUSE_CAO_BASE_URL=http://127.0.0.1:8080
MUSE_CAO_TIMEOUT_SECONDS=5

# P2: separate local Muse capability; never use COLLECTOR_TOKEN or Superset PSK here.
MUSE_CAO_EXECUTION_ENABLED=false
MUSE_CAO_MUSE_TOKEN=

# Optional ChatGPT plan research brain. Complete local OAuth first:
#   uv run muse-chatgpt-signin
# Credentials stay in a private Mac file; do not paste them into .env or Git.
MUSE_CHATGPT_ENABLED=false
MUSE_CHATGPT_AUTO_ENABLED=true
MUSE_CHATGPT_CREDENTIALS_PATH=~/.config/muse/chatgpt-plan.json
# Leave blank to use the first account-visible model returned by the plan model catalog.
MUSE_CHATGPT_MODEL=
MUSE_CHATGPT_TIMEOUT_SECONDS=60
MUSE_CHATGPT_WEB_CONTEXT=low

# P8: opt-in ONLY after CAO supplies an approved, per-user/group/project scope.
# The existing communications API is not an acceptable substitute (it includes chats).
MUSE_WECHAT_ENABLED=false
MUSE_WECHAT_SCOPE_ID=
MUSE_WECHAT_CURSOR_PATH=~/.local/share/muse/wechat-cursor.sqlite3
MUSE_WECHAT_BASE_URL=
MUSE_WECHAT_TOKEN=
